{
    "name": "easy-control",
    "version": "0.9.0",
    "private": true,
    "description": "Simple and easy to use node.js module to simulate mouse, keyboard and controller input for Windows, MacOS and Linux.",
    "keywords": [
        "GUI",
        "control",
        "mouse",
        "keyboard",
        "controller",
        "emulator",
        "automation",
        "input",
        "nodejs",
        "native",
        "addon",
        "napi",
        "cross-platform",
        "windows",
        "macos",
        "linux"
    ],
    "license": "LGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/henrikszucs/easy-control"
    },
    "bugs": "https://github.com/henrikszucs/easy-control/issues",
    "maintainers": [
        {
            "name": "Henrik Szucs",
            "email": "henrikszucs6@gmail.com"
        }
    ],
    "scripts": {
        "build": "node index.js",
        "build:js": "node src/build.js",
        "test": "node dev/test.js",
        "clean": "node index.js -- --uninstall"
    },
    "type": "module",
    "gypfile": false,
    "main": "./dist/easy-control.cjs",
    "module": "./dist/easy-control.mjs",
    "exports": {
        ".": {
            "import": "./dist/easy-control.mjs",
            "require": "./dist/easy-control.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "esbuild": "^0.28.2",
        "node-addon-api": "^8.5.0",
        "node-gyp": "^11.0.0"
    }
}
